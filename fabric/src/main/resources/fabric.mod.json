{
	"schemaVersion": 1,
	"id": "simpleprotect",
	"version": "${version}",
	"name": "SimpleProtect",
	"description": "A simple protection mod for Fabric.",
	"authors": [
		"Sumutiu"
	],
	"license": "AGPL-3.0",
	"icon": "assets/simpleprotect/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.sumutiu.simpleprotect.fabric.SimpleProtectFabric"
		]
	},
	"mixins": [
		"simpleprotect.mixins.json",
		"simpleprotect.fabric.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
